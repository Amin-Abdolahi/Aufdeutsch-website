# ============================================================
#  Alphabet World — کلیدهای AI (اختیاری)
#  حداقل یکی از اینها را تنظیم کنید. بدون کلید هم بازی
#  کامل قابل بازی است — فقط بخش «پرسش از AI» جواب‌های
#  آفلاین ساده می‌دهد.
# ============================================================

# Gemini (رایگان — https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (رایگان — https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Atria (https://atria-asi.ai)
ATRIA_API_KEY=
ATRIA_MODEL=Atria-Dawn-Preview

# OpenRouter (رایگان — https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# ============================================================
#  Upstash Redis (کاملاً اختیاری — برای rate limiting و cache)
#  بدون این‌ها از حافظه‌ی درون‌پروسه استفاده می‌شود.
# ============================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
